<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <include name="common.xml" />
  <remote name="ldts"            fetch="https://github.com/ldts" />
  <remote name="embeddedandroid" fetch="https://github.com/EmbeddedAndroid" />

  <project path="build" remote="ldts" name="qcom-buildroot.git" revision="main">
    <linkfile src="monaco.mk" dest="build/Makefile" />
  </project>

  <remove-project                      name="linaro-swg/linux.git" />
  <remove-project                      name="OP-TEE/optee_os.git" />

  <!-- linux-next with Monaco and VENTUNO Q patches not submitted yet:
       DSP (PAS) and audio restart fixes, the maxcpus fixes, and the fixes
       for the PCIe0 stall and AER flood behind the PI7C9X2G304 switch. -->
  <project path="linux"                remote="embeddedandroid" name="linux.git"                revision="985b2f70cf1528955befe96fde1d6151ca62683e" upstream="monza" clone-depth="1" />

  <!-- Monaco support under upstream review, plus patches not submitted
       yet that the board test needs. TF-A: Gerrit topic qti-monaco on the
       hoya CPUCP start series (Gerrit 54862/54863), then the SAIL
       notification (Gerrit 54579) and, not submitted, the VENTUNO Q reset
       fixes and the Monaco clock back-end and RPMh data the ADSP needs.
       OP-TEE: pull request 8053, then, not submitted, the Monaco PAS clocks
       and pseudo-TA that start the DSPs. U-Boot: the VENTUNO Q series,
       respun after its review on the U-Boot list, then, not submitted, the
       Monaco SPL patches (monaco.mk TZ_IMAGE=u-boot-spl). -->
  <project path="arm-trusted-firmware" remote="embeddedandroid" name="arm-trusted-firmware.git" revision="9f1d6711033c5e8336c6ba4b05e51837065b9f97" upstream="monza"/>
  <project path="u-boot"               remote="embeddedandroid" name="u-boot.git"               revision="952c17fd38a893d37bfb883dabbb14847c4c4ba0" upstream="monza"/>
  <project path="optee_os"             remote="embeddedandroid" name="optee_os.git"             revision="205246892290e783722bb3543868d2ca12674be4" upstream="ventuno-q"/>
</manifest>
